# Copy to .env.local for local development. Never commit real values.

# Canonical origin of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" ONLY on the approved production domain. Anything else = noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Lead delivery (choose one). Without any, the form returns 503 "not connected".
RESEND_API_KEY=
INQUIRY_TO_EMAIL=info@omniwebora.com
INQUIRY_FROM_EMAIL=
INQUIRY_WEBHOOK_URL=
# Local development only: log inquiries to the server console instead of sending.
INQUIRY_DEV_LOG=0

# Optional privacy-friendly analytics (Plausible). Leave empty to disable all tracking.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# WhatsApp contact link (digits only, with country code). Empty = no WhatsApp link shown.
NEXT_PUBLIC_WHATSAPP_NUMBER=
